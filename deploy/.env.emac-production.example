# api-mophlink.moph.go.th/drugallergy — PM2 on port 3100
# Reference only: retain existing database credentials and session secret.
NODE_ENV=production
PORT=3100
LOG_LEVEL=info

# ---- HTTP / reverse proxy ----
# nginx preserves /drugallergy
HTTP_BASE_PATH=/drugallergy
# URL สาธารณะเต็มของ service — ใช้สร้าง absolute URL (OIDC redirect, card QR, embed link)
PUBLIC_BASE_URL=https://api-mophlink.moph.go.th/drugallergy
TRUST_PROXY=true

# ---- Database (Postgres จาก docker-compose ของ emac) ----
DATABASE_URL=postgres://postgres:<STRONG_PASSWORD>@127.0.0.1:5442/drugallergy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=drugallergy
POSTGRES_PORT=5442

# ---- Adapters ----
# Portal login only; third-party OAuth is always real.
AUTH_PROVIDER=mock
# Portal only; third-party /auth/* and /search always use real Provider ID.
PORTAL_AUTH_PROVIDER=mock
# Third-party data only; independent of login and portal patient data.
# mock: MOCK-CID-001 / MOCK-CID-002; real: use the Parquet glob below.
# Applies only to /lookup; /search always reads real Parquet.
DRUGALLERGY_DATA_MODE=real
DRUGALLERGY_PARQUET_GLOB=
KEY_SERVICE=local
KEY_STORE=postgres
DATA_STORE=postgres
CONSENT_PROVIDER=mock
HIS_CONNECTOR=mock

# Required for third-party Provider ID regardless of portal mode.
MOPH_PROVIDER_BASE_URL=
MOPH_PROVIDER_CLIENT_ID=
MOPH_PROVIDER_CLIENT_SECRET=
MOPH_PROVIDER_REDIRECT_URI=https://api-mophlink.moph.go.th/drugallergy/auth/callback
MOPH_PROVIDER_FRONTEND_CALLBACK_URL=https://emac.moph.go.th/

# ---- Session JWT (ของระบบเรา) — เปลี่ยนเป็นค่า random ยาว ๆ ----
SESSION_JWT_SECRET=<CHANGE_ME_LONG_RANDOM_SECRET>
SESSION_JWT_TTL_SECONDS=900

# ---- ETL / rollout ----
RETRO_WINDOW_DAYS=30
HOSPCODE_ALLOWLIST=
